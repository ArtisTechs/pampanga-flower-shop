# Copy to .env (git-ignored) and replace the placeholder passwords before `docker compose up`.

# MySQL (docker-compose)
MYSQL_DATABASE=flower_shop
MYSQL_USER=flower_shop
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=4000

# Cloudinary (admin product image uploads). From Cloudinary Console -> Settings -> API Keys.
# The API secret is server-only: never put it in a VITE_* variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pampanga-flower-shop/products

# Frontend env vars (VITE_API_URL) live in frontend/.env.example.
