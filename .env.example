# Copy to .env (git-ignored) and replace the placeholder passwords before `docker compose up`.

# MySQL (docker-compose)
MYSQL_DATABASE=flower_shop
MYSQL_USER=flower_shop
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=4000

# Cloudinary (admin product image uploads). From Cloudinary Console -> Settings -> API Keys.
# The API secret is server-only: never put it in a VITE_* variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pampanga-flower-shop/products
# Customer profile photos (one image per account, replaced on each upload).
CLOUDINARY_AVATAR_FOLDER=pampanga-flower-shop/avatars
CLOUDINARY_PAYMENT_QR_FOLDER=pampanga-flower-shop/payment-qr
CLOUDINARY_PAYMENT_PROOF_FOLDER=pampanga-flower-shop/payment-proofs
# AI-generated customizer previews (one image per unique selection, reused afterwards).
CLOUDINARY_BUILDER_PREVIEW_FOLDER=pampanga-flower-shop/catalog/customize-previews/generated

# Customizer preview images. IMAGE_PROVIDER: cloudflare (default, free daily allowance) or gemini (paid).
# Without the chosen provider's credentials, the customizer shows the closest stock preview instead. Server-only.
IMAGE_PROVIDER=cloudflare
# New (uncached) previews a single customer may generate per hour.
IMAGE_GENERATIONS_PER_HOUR=20
# With GEMINI_API_KEY set, each new preview is checked (flower counts, colors, wrap) and regenerated if wrong,
# up to this many tries in total (1-5). Failing previews fall back to the closest stock photo.
PREVIEW_MAX_ATTEMPTS=3

# Cloudflare Workers AI. Account ID: Cloudflare dashboard home (right side).
# Token: My Profile -> API Tokens -> Create Token -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# FLUX.1 schnell only (1-8): more steps look better but use more of the daily free allowance.
CLOUDFLARE_IMAGE_STEPS=8

# Gemini. Key: Google AI Studio. The free tier covers checking previews; generating images with it
# (IMAGE_PROVIDER=gemini) needs billing enabled.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Checks generated previews (free tier)
GEMINI_CHECK_MODEL=gemini-flash-latest
# Used when the check model is busy or rate-limited
GEMINI_CHECK_FALLBACK_MODEL=gemini-flash-lite-latest

# Brevo (OTP emails for sign-up and password reset). API key: Brevo -> SMTP & API -> API Keys.
# MAIL_FROM_EMAIL must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
# Without a key, development prints codes in the backend logs; production returns 503.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pampanga Flower Shop

# Frontend env vars (VITE_API_URL) live in frontend/.env.example.
