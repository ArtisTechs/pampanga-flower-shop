# Used when running the API outside Docker (npm run dev). Copy to backend/.env.
# Inside Docker Compose these are set from the root .env instead.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (add your Vercel URL in production).
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=flower_shop
DB_USER=flower_shop
DB_PASSWORD=change-me

# Cloudinary (admin product image uploads); uploads return 503 until these are set. Server-only secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pampanga-flower-shop/products
