# Copy to frontend/.env.local if needed. VITE_* values are bundled into the browser: never put secrets here.

# Leave empty locally: /api is proxied to the backend by the Vite dev server.
# On Vercel, set this in Project Settings → Environment Variables to your deployed API origin, e.g. https://api.example.com
VITE_API_URL=

# Dev-only proxy target for /api when running `npm run dev` outside Docker (default http://localhost:4000).
# API_PROXY_TARGET=http://localhost:4001
